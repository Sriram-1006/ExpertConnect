# ExpertConnect environment variables (template)
# ---------------------------------------------------------------------------
# Copy the relevant lines to your shell / environment before running the app.
# NEVER commit real credentials or secrets. This file must contain placeholders
# only.
# ---------------------------------------------------------------------------

# MySQL connection
EXPERTCONNECT_DB_URL=jdbc:mysql://localhost:3306/expertconnect
EXPERTCONNECT_DB_USERNAME=root
EXPERTCONNECT_DB_PASSWORD=your_password

# JWT signing secret (must be at least 32 bytes for HS256)
EXPERTCONNECT_JWT_SECRET=your_jwt_secret

# Optional: token lifetime in milliseconds (default 86400000 = 24h)
EXPERTCONNECT_JWT_EXPIRATION_MS=86400000

# Optional: bootstrap ADMIN account created on startup when missing
EXPERTCONNECT_ADMIN_EMAIL=admin@example.com
EXPERTCONNECT_ADMIN_PASSWORD=your_admin_password
